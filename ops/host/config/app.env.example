# Production template. Copy outside the repository, replace placeholders, and
# pass the file to install.sh. Never commit the populated file.
COMPOSE_PROFILES=prod
APP_BIND_ADDRESS=0.0.0.0
# Preserve the managed home-server production endpoint on port 3001.
APP_HOST_PORT=3001

POSTGRES_USER=tcgplayer
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=tcgplayer

TCGTRACKING_BASE_URL=https://tcgtracking.com/tcgapi/v1
RIFTBOUND_CATEGORY_ID=89
LISTING_PRICE_MULTIPLIER=0.98
MAX_PRICE_DROP_PERCENT=20
PRICE_CHECK_INTERVAL_HOURS=12
LISTED_PRICE_ATTENTION_THRESHOLD_PERCENT=5
LISTED_PRICE_ATTENTION_MIN_DIFF_CENTS=5

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_SALE_CONFIRMED=true
TELEGRAM_NOTIFY_ORDER_SHIPPED=true
SELLER_NAME=
SELLER_ID=

# The managed deployment runs the dedicated migration job before app replacement.
RUN_MIGRATIONS_ON_START=false
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
