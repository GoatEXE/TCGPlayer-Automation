# Docker Compose mode: "dev" or "prod"
COMPOSE_PROFILES=dev

# Docker host ports
# Defaults preserve the existing URLs when only one profile is running.
# If dev is still running and you want to start prod HTTPS too, set APP_HOST_PORT=3001
# and browse to https://<host-or-ip>:3001.
APP_HOST_PORT=3000
DEV_APP_HOST_PORT=3000
VITE_HOST_PORT=5173

# Database
POSTGRES_USER=tcgplayer
POSTGRES_PASSWORD=tcgplayer
POSTGRES_DB=tcgplayer

# For Docker: use 'db' (prod) or 'db-dev' (dev) as hostname (Docker DNS)
# For local development: use 'localhost'
DATABASE_URL=postgresql://tcgplayer:tcgplayer@db-dev:5432/tcgplayer

# TCGTracking API (no auth needed)
TCGTRACKING_BASE_URL=https://tcgtracking.com/tcgapi/v1

# Riftbound category ID on TCGPlayer/TCGTracking
RIFTBOUND_CATEGORY_ID=89

# Pricing
MIN_LISTING_PRICE_CENTS=5
LISTING_PRICE_MULTIPLIER=0.98
MAX_PRICE_DROP_PERCENT=20

# Price checking
# How often the background price-check scheduler runs.
PRICE_CHECK_INTERVAL_HOURS=12
# For already-listed cards, mark needs_attention when the saved listing price
# differs from the current recommended price by at least this percentage.
LISTED_PRICE_ATTENTION_THRESHOLD_PERCENT=5
# For already-listed cards, only mark needs_attention for drift when the
# absolute difference from the current recommended price is at least this many cents.
LISTED_PRICE_ATTENTION_MIN_DIFF_CENTS=5

# Redis
# For Docker: use 'redis' (prod) or 'redis-dev' (dev) as hostname (Docker DNS)
# For local development: use 'localhost'
REDIS_URL=redis://localhost:6379

# Scanner OCR
# Leave blank to use `tesseract` from PATH locally; Docker Compose defaults this
# to the image's `/usr/bin/tesseract` path for app/app-dev containers.
TESSERACT_BIN=
# Optional; Docker images include ImageMagick for ROI upscale/invert preprocessing.
IMAGEMAGICK_BIN=
SCANNER_OCR_DEBUG=false

# Telegram (Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_SALE_CONFIRMED=true
TELEGRAM_NOTIFY_ORDER_SHIPPED=true

# Seller info for invoice / packing slip templates (Phase 3.3)
SELLER_NAME=
SELLER_ID=

# Optional local HTTPS (for mobile browser camera APIs on LAN)
# Docker builds generate these files inside the image. HTTPS_ENABLED=false
# keeps HTTP mode, even if cert/key paths are still present.
# To use HTTPS, set HTTPS_ENABLED=true and point to the generated cert/key paths below.
HTTPS_ENABLED=false
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
# HTTPS_CERT_FILE=/app/certs/local-cert.pem
# HTTPS_KEY_FILE=/app/certs/local-key.pem
# Rebuild after changing SANs. Include the LAN IP/hostname you will browse to.
# LOCAL_HTTPS_CERT_SANS=DNS:localhost,IP:127.0.0.1,IP:192.168.1.50

# Server container port. Docker host ports are configured above.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
